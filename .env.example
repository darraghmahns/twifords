# Copy to .env.local for local dev. In production set these with `vercel env add <NAME> production`.
# The password Jack & Anne type to open the site.
SITE_PASSWORD='change-me'
# Random 32+ byte hex string used to sign the session cookie: `openssl rand -hex 32`
SESSION_SECRET='change-me'
# Minified JSON of secrets/gift-cards.json (see secrets/gift-cards.example.json for the shape):
#   vercel env add GIFT_CARDS_JSON production < secrets/gift-cards.json
GIFT_CARDS_JSON='{}'
